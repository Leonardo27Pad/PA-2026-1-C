<Window x:Class="Examen01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Examen01"
        mc:Ignorable="d"
        Title="Auto-Limpio Expres" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF40F01F" Offset="0.316"/>
            <GradientStop Color="#FFFFF000" Offset="1"/>
            <GradientStop Color="#FFDBF005" Offset="0.493"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="104*"/>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Registro de Servicio" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                <Label Content="Placa del Vehículo:" FontWeight="Bold"/>
                <TextBox x:Name="txtPlaca" Margin="0,0,0,10"/>

            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" >
                <Label Content="Tipo de Vehículo:" FontWeight="Bold"/>
                <ComboBox x:Name="cboTipoVehiculo" >
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="Camioneta"/>
                    <ComboBoxItem Content="SUV"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Margin="0,90,0,0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Label Content="Servicios Adicionales:" FontWeight="Bold"/>
                <CheckBox x:Name="chkEncerado" Content="Encerado Premium (S/ 15)" Margin="0,5,0,5" Foreground="#FF2806B4"/>
                <CheckBox x:Name="chkLavadoMotor" Content="Lavado de Motor (S/ 20)" Margin="0,5,0,5" Foreground="#FF2806B4"/>
                <CheckBox x:Name="chkLimpiezaSalon" Content="Limpieza de Salón (S/ 25)" Margin="0,5,0,15" Foreground="#FF2806B4"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnRegistrar" Content="Registrar Servicio" Height="25" Click="btnRegistrar_Click" Width="210" Background="#FF1CBDBD" BorderBrush="#FF3A00FF" Foreground="#FF105E01" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <ListBox x:Name="lstHistorial" Height="156" FontFamily="Consolas" FontStyle="Italic" />
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="lblAutos" Text="Autos: " Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBlock x:Name="lblCamionetas" Text="Camionetas: " FontWeight="Bold"/>
                <TextBlock x:Name="lblSUV" Text="SUV: " FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="lblLimpiezaSalon" Text="Limpieza de Salón: " Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBlock x:Name="lblTotalRecaudado" Text="Total Recaudado: " FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
