<Window x:Class="Seman06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Seman06"
        mc:Ignorable="d"
        Title="Centro Odontologico" Height="450" Width="800">
    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="116*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="txtPaci"  HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Bottom" Width="197" Margin="134,0,0,0" Height="25"/>
                <TextBlock HorizontalAlignment="Left" Margin="62,0,0,0" TextWrapping="Wrap" Text="Paciente:" VerticalAlignment="Bottom" FontWeight="Bold" FontSize="14"/>
                <TextBlock HorizontalAlignment="Left" Margin="62,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Tratamiento:" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                <TextBlock HorizontalAlignment="Left" Margin="62,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Pieza Denatal:" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                <ComboBox x:Name="CmbTrat" HorizontalAlignment="Left" Margin="165,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="165" Height="30">
                    <ComboBoxItem Content="Endodoncia"/>
                </ComboBox>
                <ComboBox x:Name="cmbPieDen" HorizontalAlignment="Left" Margin="165,0,0,0" Grid.Row="2" VerticalAlignment="Top" Width="166" Height="30">
                    <ComboBoxItem Content="Incrusta"/>
                    <ComboBoxItem Content="Funda"/>
                </ComboBox>
            </Grid>
            <Calendar x:Name="calCita" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,38,0,0" TextWrapping="Wrap" Text="Fecha:" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" RenderTransformOrigin="0.159,1.518" Width="66"/>
        </Grid>
        <Grid Grid.Row="1">
            <Button x:Name="btnCrono" Content="Cronogramar" HorizontalAlignment="Center" VerticalAlignment="Center" Width="176" FontWeight="Bold" Height="26" Click="btnCrono_Click"/>
        </Grid>
        <Grid Grid.Row="2">
        <TextBox x:Name="txtReporte" TextWrapping="Wrap" Text="" Margin="50,10,50,10"/>
        </Grid>
    </Grid>
</Window>
