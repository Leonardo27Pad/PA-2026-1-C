<Window x:Class="Semana05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana05"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock TextWrapping="Wrap" Text="Cliente:" VerticalAlignment="Center" Width="80" FontWeight="Bold"/>
                <TextBox x:Name="txtCliente" TextWrapping="Wrap" Text="" Width="203" Height="26"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Monto a Pagar:" VerticalAlignment="Center" Width="94" FontWeight="Bold"/>
                <TextBox x:Name="txtMonto" TextWrapping="Wrap" Text="" Width="203" Height="26"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock TextWrapping="Wrap" Text="Fch. Vence: "  VerticalAlignment="Center" Width="80" FontWeight="Bold"/>
                <DatePicker x:Name="dpVenc" Height="26" Width="203"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Fch. Pago: "  VerticalAlignment="Center" Width="94" FontWeight="Bold"/>
                <DatePicker x:Name="dpPago" Height="26" Width="203"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,20">
                <Button x:Name="btnCalcular" Content="Calcular" Width="50" Click="btnCalcular_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
                <Button x:Name="btnNuevo" Content="Nuevo" Width="50" Click="btnNuevo_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,20">
                <Button x:Name="Finalizar" Content="Finalizar" Width="50" Click="btnFinalizar_Click"/>

            </StackPanel>
            

        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock TextWrapping="Wrap" Text="Dias de Mora:" VerticalAlignment="Center" Width="99" FontWeight="Bold"/>
                <TextBox x:Name="txtDiasMora" TextWrapping="Wrap" Text="" Width="157" Height="26"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Mora en S/:" VerticalAlignment="Center" Width="100" FontWeight="Bold"/>
                <TextBox x:Name="txtMoraSoles" TextWrapping="Wrap" Text="" Width="157" Height="26" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock TextWrapping="Wrap" Text="Mora en %:" VerticalAlignment="Center" Width="99" FontWeight="Bold"/>
                <TextBox x:Name="txtMoraPorc" TextWrapping="Wrap" Text="" Width="157" Height="26"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Monto a Pagar:" VerticalAlignment="Center" Width="99" FontWeight="Bold"/>
                <TextBox x:Name="txtMontoPagar" TextWrapping="Wrap" Text="" Width="157" Height="26"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
