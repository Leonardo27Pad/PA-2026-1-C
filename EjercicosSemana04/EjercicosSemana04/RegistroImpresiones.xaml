<Window x:Class="EjercicosSemana04.RegistroImpresiones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjercicosSemana04"
        mc:Ignorable="d"
        Title="RegistroImpresiones" Height="450" Width="800">
    <Grid Height="473" VerticalAlignment="Center">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFA2CB2F" Offset="0.389"/>
                <GradientStop Color="#FF509AFF" Offset="0.72"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="67,33,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Cantidad:" HorizontalAlignment="Left"  Margin="68,77,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro Celular:" HorizontalAlignment="Left"   Margin="468,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="páginas" HorizontalAlignment="Left" Margin="270,79,0,0" VerticalAlignment="Top"/>
        <Label Content="Tarifa:" HorizontalAlignment="Left" Margin="73,130,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="67,33,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="55,191,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro Celular:" HorizontalAlignment="Left" Margin="468,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro Celular:" HorizontalAlignment="Left" Margin="206,192,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Cantidad:" HorizontalAlignment="Left" Margin="338,190,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Tarifa:" HorizontalAlignment="Left" Margin="494,192,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Importe:" HorizontalAlignment="Left" Margin="620,192,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro impre. escolares:" HorizontalAlignment="Left" Margin="59,386,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro impre. universitarias:" HorizontalAlignment="Left" Margin="60,422,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Nro impre. organizacionales:" HorizontalAlignment="Left" Margin="427,388,0,0" VerticalAlignment="Top"  FontWeight="Bold"/>
        <TextBox x:Name="txtCliente" HorizontalAlignment="Left" Margin="142,39,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtNCelular" HorizontalAlignment="Left" Margin="552,39,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCantidad" HorizontalAlignment="Left" Margin="140,83,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <RadioButton x:Name="rbEscolar" Content="Escolar"  HorizontalAlignment="Left" Margin="142,137,0,0" VerticalAlignment="Top"  GroupName="g_tarifa"/>
        <RadioButton x:Name="rbUniversitario" Content="Universitario" HorizontalAlignment="Left" Margin="218,137,0,0" VerticalAlignment="Top" GroupName="g_tarifa"/>
        <RadioButton x:Name="rbOrganizacion" Content="Organización"  HorizontalAlignment="Left" Margin="324,139,0,0" VerticalAlignment="Top"  GroupName="g_tarifa"/>
        <ListBox x:Name="lbCliente" Margin="53,220,631,99" SelectionChanged="lbCliente_SelectionChanged" FontFamily="Consolas"/>
        <ListBox x:Name="lbCelular" Margin="196,220,488,99" FontFamily="Consolas"/>
        <ListBox x:Name="lbCantidad" Margin="334,220,350,99" FontFamily="Consolas"/>
        <ListBox x:Name="lbTarifa" Margin="468,219,216,100" FontFamily="Consolas"/>
        <ListBox x:Name="lbImporte" Margin="604,219,80,100" FontFamily="Consolas"/>
        <TextBox x:Name="txtImpreEcolares" HorizontalAlignment="Left" Margin="202,392,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontFamily="Consolas"/>
        <TextBox x:Name="txtImpreUniversitarias" HorizontalAlignment="Left"  Margin="218,428,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontFamily="Consolas"/>
        <TextBox x:Name="txtImpreOrganizacionales" HorizontalAlignment="Left" Margin="606,396,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontFamily="Consolas"/>
        <Button x:Name="btnEstadistica" Content="Estadística" HorizontalAlignment="Left" Margin="627,142,0,0" VerticalAlignment="Top" Click="btnEstadistica_Click" Width="98" Background="#FFE8144A"/>
        <Button x:Name="btnRegistrar" Content="Registrar" HorizontalAlignment="Left" Margin="502,142,0,0" VerticalAlignment="Top" Click="btnRegistrar_Click" Background="#FFE8144A" Width="105"/>
    </Grid>
</Window>
