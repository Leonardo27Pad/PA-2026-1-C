<Window x:Class="Juego21.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Juego21"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="btnNuevoJuego" Grid.Row="0" Content="Nuevo Juego" Width="100" HorizontalAlignment="Center" Margin="0,5" Click="NuevoJuego_Click" />

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Jugador 1 -->
            <Border Grid.Column="0" Background="#2E8B57" CornerRadius="5" Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="lblJugador1" Foreground="White" FontWeight="Bold" DockPanel.Dock="Top">Jugador 1 Puntos: 0</TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="btnP1Pedir" Content="Pedir Carta" Width="80" Margin="5" Click="BtnP1Pedir_Click" />
                        <Button x:Name="btnP1Plantarse" Content="Plantarse" Width="80" Margin="5" Click="BtnP1Plantarse_Click" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="p1CardsPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Spacer -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" />

            <!-- Jugador 2 -->
            <Border Grid.Column="2" Background="#2E8B57" CornerRadius="5" Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="lblJugador2" Foreground="White" FontWeight="Bold" DockPanel.Dock="Top">Jugador 2 Puntos: 0</TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="btnP2Pedir" Content="Pedir Carta" Width="80" Margin="5" Click="BtnP2Pedir_Click" />
                        <Button x:Name="btnP2Plantarse" Content="Plantarse" Width="80" Margin="5" Click="BtnP2Plantarse_Click" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="p2CardsPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Background="#FFF3C4" Padding="8" TextAlignment="Center" FontWeight="Bold">Estado del juego</TextBlock>

    </Grid>
</Window>
