<Window x:Class="JuegoEdad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JuegoEdad"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtMinimo" HorizontalAlignment="Right" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="80"  Height="40"/>
            <TextBox x:Name="txtMaximo" Grid.Column="2" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Center"  Width="80"  Height="40"/>
        </Grid>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="190">
            <Button x:Name="btnPrimerInt" Content="Primer Intento" Height="40" Width="190" FontWeight="Bold" Click="btnPrimerInt_Click"/>
        </StackPanel>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCorrecto" Content="Correcto" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Height="40" Click="btnCorrecto_Click"/>
            <Button x:Name="btnIncorrecto" Grid.Column="2" Content="Incorrecto" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="80" Height="40" Click="btnIncorrecto_Click"/>
        </Grid>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Indicale al computador un intervalo de edades" VerticalAlignment="Center" Height="26" Width="267" FontWeight="Bold"/>
        <TextBlock  Grid.Row="3"  HorizontalAlignment="Center" TextWrapping="Wrap" Text="La computadora piensa que tu edad es: " VerticalAlignment="Center" Height="26" Width="227" FontWeight="Bold"/>
        <TextBox x:Name="txtNumeroPensado" HorizontalAlignment="Center"  Grid.Row="4" TextWrapping="Wrap" Text="" VerticalAlignment="Center"  Width="80"  Height="40"/>

    </Grid>
</Window>
