        <Label x:Name="l_puntaje" Content="" HorizontalAlignment="Left" 
Margin="560,207,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="36" 
Width="68" RenderTransformOrigin="1.169,0.329" Background="#FFFBEB7B" Height="62" 
