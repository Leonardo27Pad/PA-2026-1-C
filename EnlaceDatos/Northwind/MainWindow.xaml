<Window x:Class="Northwind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Northwind"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock TextWrapping="Wrap" Text="Seleccionar Pais"/>
            <ComboBox x:Name="cbxPais" Margin="10,0,0,0" Width="200" SelectionChanged="cbxPais_SelectionChanged" />
        </StackPanel>
        <ListView x:Name="lvClientes" Grid.Row="1" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding CustomerID}"/>
                    <GridViewColumn Header="Compania" Width="200" DisplayMemberBinding="{Binding CompanyName}"/>
                    <GridViewColumn Header="Contacto" Width="200" DisplayMemberBinding="{Binding ContactName}"/>
                    <GridViewColumn Header="Pais" Width="200" DisplayMemberBinding="{Binding Country}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
