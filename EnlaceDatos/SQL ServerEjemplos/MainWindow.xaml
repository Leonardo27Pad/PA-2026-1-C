<Window x:Class="SQL_ServerEjemplos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQL_ServerEjemplos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="335*"/>
        </Grid.RowDefinitions>
        <Button x:Name="btnConectar" Content="Verificar Conectar" HorizontalAlignment="Left" Margin="40,28,0,0" VerticalAlignment="Top" Click="btnVerificarConexion_Click"/>
        <ComboBox x:Name="cbxCategorias" HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top" Width="120" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
        <Button x:Name="btnCargar" Content="Cargar Categorias" HorizontalAlignment="Left" Margin="179,28,0,0" VerticalAlignment="Top" Click="btnCargarCategorias_Click"/>
        <Button x:Name="btnMostrarSeleccionado" Content="Seleccionado" HorizontalAlignment="Left" Margin="519,28,0,0" VerticalAlignment="Top" Click="btnMostrarSeleccionado_Click"/>
        <DataGrid x:Name="dgProductos" Grid.Row="1" />
        <Button x:Name="btnCargarProductos" Content="Productos" HorizontalAlignment="Left" Margin="624,28,0,0" VerticalAlignment="Top" Click="btnCargarProductos_Click"/>

    </Grid>
</Window>
