<Window x:Class="Semana04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana04"
        mc:Ignorable="d"
        Title="MetodosMostrarItems" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="225*"/>
            <RowDefinition Height="209*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="203*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button Content="ComboBox" Height="226" Click="Button_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <Button Content="ListBox" Height="226" Click="Button_Click_1"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button Content="ListView" Height="209" Click="Button_Click_2"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1"/>

    </Grid>
</Window>
