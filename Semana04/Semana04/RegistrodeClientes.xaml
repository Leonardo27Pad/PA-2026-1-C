<Window x:Class="Semana04.RegistrodeClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana04"
        mc:Ignorable="d"
            Title="RegistrodeClientes" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="215*"/>
            <RowDefinition Height="219*"/>
        </Grid.RowDefinitions>
        <Label Content="Nombres" HorizontalAlignment="Left" Margin="66,26,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Apellidos   " HorizontalAlignment="Left" Margin="442,26,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.137,0.687" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="66,57,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="442,57,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Nombres" HorizontalAlignment="Left" Margin="67,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        <Label Content="Direccion" HorizontalAlignment="Left" Margin="304,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        <Label Content="Estado Civil" HorizontalAlignment="Left" Margin="66,148,0,0" VerticalAlignment="Top" Height="23" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="67,125,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="304,125,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="274"/>
        <Button Content="Agregar" HorizontalAlignment="Left" Margin="304,184,0,0" VerticalAlignment="Top" Width="88" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Button Content="Salir" HorizontalAlignment="Left" Margin="673,185,0,0" VerticalAlignment="Top" Width="82"/>
        <Button Content="Estadistica" HorizontalAlignment="Left" Margin="558,184,0,0" VerticalAlignment="Top"/>
        <Button Content="Nuevo" HorizontalAlignment="Left" Margin="428,184,0,0" VerticalAlignment="Top" Width="87"/>
        <ComboBox HorizontalAlignment="Left" Margin="67,184,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Soltero(a)"/>
            <ComboBoxItem Content="Casado(a)"/>
        </ComboBox>
        <ListView Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nombres" Width="270" DisplayMemberBinding="{Binding nombres}"/>
                    <GridViewColumn Header="Apellidos" Width="270" DisplayMemberBinding="{Binding apellidos}"/>
                    <GridViewColumn Header="DNI" Width="260" DisplayMemberBinding="{Binding edad}"/>
                    <GridViewColumn Header="Direccion" Width="260" DisplayMemberBinding="{Binding direccion}"/>
                    <GridViewColumn Header="Estado Civil" Width="260" DisplayMemberBinding="{Binding estadoCivil}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
