<Window x:Class="Semana04.Listbox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana04"
        mc:Ignorable="d"
        Title="Listbox" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="28,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="es-mx" Text="Frutas"/><LineBreak/><Run Language="es-mx"/></TextBlock>
        <ListBox x:Name="lbFrutas"  Margin="28,54,626,269">
            <ListBoxItem Content="Pera"/>
            <ListBoxItem Content="Piña"/>
        </ListBox>
        <Button Content="Mostar" HorizontalAlignment="Left" Margin="28,184,0,0" VerticalAlignment="Top" Width="146" Click="btMostrar_Click"/>
        <Button x:Name="btAgregar" Content="Agregar" HorizontalAlignment="Left" Margin="28,332,0,0" VerticalAlignment="Top" Width="170" Click="btAgregar_Click"/>
        <Label Content="Agregue una Fruta" HorizontalAlignment="Left" Margin="28,267,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNuevo" HorizontalAlignment="Left" Margin="28,298,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
