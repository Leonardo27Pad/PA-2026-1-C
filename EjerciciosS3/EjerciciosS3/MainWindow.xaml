<Window x:Class="EjerciciosS3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjerciciosS3"
        mc:Ignorable="d"
        Title="RadioYCheck" Height="450" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="104" Margin="30,43,0,0" Stroke="Black" VerticalAlignment="Top" Width="570"/>
        <CheckBox x:Name="cb_tipodeletra" Content="Cambio de tipo de letra" HorizontalAlignment="Left" Margin="44,58,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cb_colordetexto" Content="Cambiar el color de texto" HorizontalAlignment="Left" Margin="44,78,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cb_colordefondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="44,98,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lb_checkbox" Content="Uso de control CheckBox" HorizontalAlignment="Center" Margin="0,95,0,0" VerticalAlignment="Top"/>
        <Button x:Name="b_aplicar" Content="Aplicar" HorizontalAlignment="Center" Margin="0,63,0,0" VerticalAlignment="Top" Click="b_aplicar_Click"/>
        <Label Content="Control CheckBox" HorizontalAlignment="Left" Margin="22,10,0,0" VerticalAlignment="Top"/>
        <Rectangle HorizontalAlignment="Left" Height="100" Margin="30,264,0,0" Stroke="Black" VerticalAlignment="Top" Width="570"/>
        <Label Content="Control RadioButton" HorizontalAlignment="Left" Margin="30,233,0,0" VerticalAlignment="Top" Width="130"/>
        <RadioButton x:Name="rb_tipodeletra" Content="Cambiar tipo de letra" HorizontalAlignment="Left" Margin="44,282,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rb_colordetexto" Content="Cambiar color de texto" HorizontalAlignment="Left" Margin="44,302,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rb_colodefondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="44,322,0,0" VerticalAlignment="Top"/>
        <Button x:Name="b_aplicar1" Content="Aplicar" HorizontalAlignment="Center" Margin="0,287,0,0" VerticalAlignment="Top" Click="b_aplicar1_Click"/>
        <Label x:Name="lb_radiobutton" Content="Uso de control radiobutton" HorizontalAlignment="Center" Margin="0,317,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
