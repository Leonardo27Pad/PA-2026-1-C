<Window x:Class="Semana08.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana08"
        mc:Ignorable="d"
        Title="MenuPrincipal" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="New" CanExecute="CommandBinding_New"/>
        <CommandBinding Command="Open" CanExecute="CommandBinding_Open"/>
    </Window.CommandBindings>
    <Grid>
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Height="18">
                <MenuItem  Header="_Archivo">
                    <MenuItem Header="Nuevo" Command="New"/>
                    <MenuItem Header="A_brir" Command="Open"/>
                    <MenuItem Header="Guardar"/>
                    <Separator/>
                    <MenuItem Header="_Salir" Click="MenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="_Herramientas">
                    <MenuItem Header="Administrar Usuarios">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="UserAdd" ></materialDesign:PackIcon>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mostrar Grupos" IsCheckable="True" IsChecked="True"/>

                </MenuItem>
            </Menu>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button>
                        <StackPanel>
                            <Image Source="C:/Imagenes/icons8-pegar-50.png" Width="24" Height="24"/>
                            <TextBlock Text="Nuevo" />
                        </StackPanel>
                    </Button>

                    <Button Content="Abrir"/>
                    <Button Content="Guardar"/>
                </ToolBar>
                <ToolBar>
                    <Button Content="Cortar" Command="Cut"/>
                    <Button Content="Copiar" Command="Copy"/>
                    <Button Content="Pegar"  Command="Paste"/>
                </ToolBar>
            </ToolBarTray>
            <TextBox TextWrapping="Wrap" Text="TextBox" Height="381" Width="316"/>
        </DockPanel>
    </Grid>
</Window>
