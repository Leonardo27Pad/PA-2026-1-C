<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana08"       
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Class="Semana08.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30,25,30,25"
          >
        <Button x:Name="HasClik" Content="Has Clik Derecho" HorizontalAlignment="Center" Margin="0                 " VerticalAlignment="Center" Padding="10,5,10,5">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Menú item 1"/>
                    <MenuItem Header="Menú item 2"/>
                    <Separator/>
                    <System:String xml:space="preserve">//SEPARADOR LINEA </System:String>
                    <MenuItem Header="Menú item 3"/>
                    <MenuItem Header="Salir">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon 
                               Kind="ExitToApp"
                               Width ="24"
                               Height="24"
                               Foreground ="Blue"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <TextBox HorizontalAlignment="Center" Margin="0,259,0,0" TextWrapping="Wrap" Text="Clik derecho para mostrar el menú contextual" VerticalAlignment="Top" Width="272" Height="31">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="Cut">
                        <MenuItem.Icon>
                            <Image Source="C:/Imagenes/icons8-cortar-32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="Copy">
                        <MenuItem.Icon>
                            <Image Source="C:/Imagenes/icons8-copiar-50.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="Paste">
                        <MenuItem.Icon>
                            <Image Source="C:/Imagenes/icons8-pegar-50.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

    </Grid>
</Window>