<Window x:Class="TareaBingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TareaBingo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FFB9B9F4" Margin="0,0,5,0">
            <Grid Margin="5,0,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="155"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="BINGO" FontSize="20" FontWeight="Bold" Foreground="#FFFF5D5D" HorizontalAlignment="Center"/>

                <Label Grid.Row="1" Background="#181825" Width="95" HorizontalAlignment="Center" BorderBrush="#89B4FA" BorderThickness="3" Margin="0,5,0,5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="80">
                        <TextBlock x:Name="txtLetraBolilla" Text="-" FontSize="25" FontWeight="Bold" Foreground="#FAB387" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNumeroBolilla" Text="--" FontSize="40" FontWeight="Black" Foreground="#89B4FA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Label>

                <StackPanel Grid.Row="2">
                    <Button x:Name="btnGenerarCartilla" Content="1. Generar Cartilla" Height="25" Margin="0,3" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="13" Click="btnGenerarCartilla_Click"/>
                    <Button x:Name="btnIniciarJuego" Content="2. Iniciar Juego" Height="25" Margin="0,3" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="13" IsEnabled="False" Click="btnIniciarJuego_Click"/>
                    <Button x:Name="btnSacarBolilla" Content="Sacar Siguiente Bolilla" Height="25" Margin="0,3" Background="#FAB387" Foreground="#11111B" FontWeight="Bold" FontSize="13" IsEnabled="False" Click="btnSacarBolilla_Click"/>
                    <Button x:Name="btnAutoJuego" Content="Modo Automático" Height="25" Margin="0,3" Background="#F5C2E7" Foreground="#11111B" FontWeight="Bold" FontSize="13" IsEnabled="False" Click="btnAutoJuego_Click"/>
                    <Button x:Name="btnReiniciar" Content="Reiniciar Juego" Height="25" Margin="0,3" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="13" Click="btnReiniciar_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Historial de Bolillas:"  FontWeight="SemiBold" Foreground="#FF0E0D0D"/>
                <ListBox x:Name="lstHistorial" Grid.Row="4" Background="#FF142865" Foreground="#FFEDEDED" FontSize="16" />
            </Grid>
        </Border>
        <Border Grid.Column="1" Margin="5,0,0,0"  Background="#FF39393F"/>
        <Grid Grid.Column="1" Margin="5,5,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="TU CARTILLA" FontSize="22" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <UniformGrid Grid.Row="1" Columns="5">
                <Label Background="#F38BA8" Margin="3" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="B" FontSize="22" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Label>
                <Label Background="#FAB387" Margin="3" Height="40" HorizontalContentAlignment="Center">
                    <TextBlock Text="I" FontSize="22" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Label>
                <Label Background="#F9E2AF" Margin="3" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="N" FontSize="22" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Label>
                <Label Background="#A6E3A1" Margin="3" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="G" FontSize="22" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Label>
                <Label Background="#89B4FA"  Margin="3" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="O" FontSize="22" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Label>
            </UniformGrid>
            <UniformGrid x:Name="bingoCartilla" Grid.Row="2" Rows="5" Columns="5"/>
        </Grid>
    </Grid>
</Window>

