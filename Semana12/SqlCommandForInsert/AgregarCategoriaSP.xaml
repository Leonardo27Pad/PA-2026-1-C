<Window x:Class="SqlCommandForInsert.AgregarCategoriaSP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Categorías" Height="450" Width="800" Loaded="Window_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Nombre:" Width="100" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtNombre" Width="250" Padding="2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Descripción:" Width="100" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtDescripcion" Width="250" Padding="2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="btnNuevo" Content="Nuevo" Width="100" Margin="0,0,15,0" Padding="5" Click="btnNuevo_Click"/>
                <Button x:Name="btnAgregar" Content="Guardar " Width="120" Padding="5" Click="btnAgregar_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje" Text="" Foreground="Blue" FontWeight="Bold" HorizontalAlignment="Center"/>

        </StackPanel>

        <DataGrid x:Name="dgCategorias" Grid.Row="1" IsReadOnly="True" 
                  AutoGenerateColumns="True" AlternatingRowBackground="#FFF0F0F0">
        </DataGrid>

    </Grid>
</Window>